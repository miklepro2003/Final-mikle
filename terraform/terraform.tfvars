# ====== Настройки аккаунта AWS ======
region = "eu-central-1" # регион, где создаём всю инфраструктуру
# ====== Общие настройки инфраструктуры ======
name = "mikle" # имя кластера (используется как префикс для всех названий), также часть адреса сайта
tags = {
  Environment = "test" # метка окружения (тест)
  TfControl   = "true" # метка, показывающая, что ресурс создан через Terraform
}
# ====== Настройки домена ======
zone_name = "mikle-final.pp.ua" # наш купленный домен, зона которого делегирована в Route53
