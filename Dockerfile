# Базовый образ: официальный Python 3.12 в облегчённой (slim) версии
FROM python:3.12-slim
# Сразу выводить вывод Python в логи контейнера, без буферизации
ENV PYTHONUNBUFFERED=1
# Рабочая директория внутри образа; если папки нет, Docker создаст её
WORKDIR /app
# Копируем app.py с хоста в рабочую директорию образа
COPY app.py .
# Документируем, что приложение слушает порт 8080 (сам порт это не открывает)
EXPOSE 8080
# Команда, которая выполнится при старте контейнера
CMD ["python", "app.py"]
