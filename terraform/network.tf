module "network" {               # вызываем модуль network (создаёт VPC, IGW, подсети и таблицу маршрутов
  source = "./modules/network"    # путь к папке модуля относительно текущей папки
  name   = var.name                         # имя кластера, из него строятся названия и теги
  tags   = var.tags                              # общие теги для всех ресурсов
}
